{
  "name": "kojirock5260/laravel-json-schema-validate",
  "description": "OpenAPI 3.1 / JSON Schema 2020-12 request and response validation for Laravel",
  "keywords": ["laravel", "json schema", "openapi", "api", "validation"],
  "license": "MIT",
  "authors": [
    {
      "name": "kojirock5260",
      "email": "kojirock5260@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "devizzent/cebe-php-openapi": "^1.1",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "opis/json-schema": "^2.6",
    "symfony/yaml": "^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Kojirock5260\\JsonSchemaValidate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kojirock5260\\JsonSchemaValidate\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Kojirock5260\\JsonSchemaValidate\\JsonSchemaServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "lint": "pint",
    "lint:test": "pint --test",
    "stan": "phpstan analyse",
    "check": [
      "@lint:test",
      "@stan",
      "@test"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "laravel/pint": "^1.30",
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "phpstan/phpstan": "^2.2"
  }
}
